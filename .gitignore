# ══════════════════════════════════════════════════════════
#  WVAT 项目 .gitignore
#  原则：源码与文档入库；编译产物、依赖包、原始资料不入库
# ══════════════════════════════════════════════════════════

# ── Keil / ARMCC 编译产物（约 100MB，可完全重建）──────────
01_firmware/keil/**/MDK-ARM/output/
01_firmware/keil/**/Objects/
01_firmware/keil/**/Listings/
01_firmware/keil/**/DebugConfig/
01_firmware/keil/**/RTE/
01_firmware/keil/**/*.o
01_firmware/keil/**/*.d
01_firmware/keil/**/*.crf
01_firmware/keil/**/*.dep
01_firmware/keil/**/*.lnp
01_firmware/keil/**/*.axf
01_firmware/keil/**/*.map
01_firmware/keil/**/*.hex
01_firmware/keil/**/*.bin
01_firmware/keil/**/*.htm
01_firmware/keil/**/*.lst
01_firmware/keil/**/*.uvguix.*
01_firmware/keil/**/JLinkLog.txt
01_firmware/keil/**/*.bak_*

# ── 依赖包 ──────────────────────────────────────────────
vendor/_pylibs/
vendor/_wheels/
vendor/*.whl
vendor/*.zip
vendor/*.exe

# 离线器件包保留（Keil 装 STM32F4 支持包用）
!vendor/*.pack

# ── 原始资料（4MB+，可从公开链接重新获取）────────────────
04_docs/_raw/

# ── 运行产物 ────────────────────────────────────────────
02_gateway/__pycache__/
02_gateway/latency.csv

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── 编辑器 / 系统 ────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini

# ── 本地密钥（绝不入库）────────────────────────────────
.env
*.key

# ── 临时文件 ────────────────────────────────────────────
_tmp_*
temp_*/
shots/
_m.txt
